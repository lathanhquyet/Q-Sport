# Q-Sport Online Store - Public Environment Variables Example
# Duplicate this file to .env.local for local development.
# DO NOT put secret keys, Telegram tokens, or database credentials here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# WeatherAPI.com Public Key for Footer Weather Widget (TP. Hồ Chí Minh)
VITE_WEATHERAPI_KEY=YOUR_WEATHERAPI_KEY_HERE
